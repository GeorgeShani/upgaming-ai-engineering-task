# Copy this file to .env. Never put these values in VITE_* variables or Git.
OPENAI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
GENERATION_MODEL=gpt-5.4-mini-2026-03-17
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
# Use a long random token. Mutating document routes are disabled while this is empty.
DEMO_ADMIN_TOKEN=
DOCUMENT_COLLECTION_PREFIX=investigation
# A is provisional until development evaluation; changing model/dimensions requires reindexing.
RETRIEVAL_STRATEGY=a
# Local cache / conservative ledger. Render's temporary disk does not enforce an account cap.
USAGE_DB=data/usage.sqlite3
API_BUDGET_USD=4.5
EMBEDDING_USD_PER_MILLION=0.02
GENERATION_INPUT_USD_PER_MILLION=0.75
GENERATION_OUTPUT_USD_PER_MILLION=4.5
